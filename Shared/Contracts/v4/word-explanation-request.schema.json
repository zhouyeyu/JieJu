{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jieju.app/contracts/v4/word-explanation-request.schema.json",
  "title": "WordExplanationRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "selectedText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sentenceContext": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "precedingContext": { "type": ["string", "null"], "maxLength": 2000 },
    "followingContext": { "type": ["string", "null"], "maxLength": 2000 },
    "sourceLanguage": { "type": "string", "minLength": 1 },
    "explanationLanguage": { "type": "string", "minLength": 1 }
  },
  "required": ["selectedText", "sentenceContext", "sourceLanguage", "explanationLanguage"],
  "examples": [{
    "selectedText": "飛行機",
    "sentenceContext": "その巨大な飛行機は厚い雨雲をくぐり抜けて降下した。",
    "precedingContext": null,
    "followingContext": null,
    "sourceLanguage": "Japanese",
    "explanationLanguage": "Chinese"
  }]
}
